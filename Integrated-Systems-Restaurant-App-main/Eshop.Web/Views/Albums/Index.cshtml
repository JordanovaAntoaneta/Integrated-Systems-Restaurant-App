@model IEnumerable<ERestaurant.Domain.Domain.Album>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Where Music Meets Meals!</h1>

<p>Introducing "Tune and Dine," the perfect harmony between Rhapsody, your favorite music store, and DineMaster, your go-to restaurant ordering system! <br /> 
    Now, while you savor delicious dishes from DineMaster, you can discover exclusive music playlists curated by Rhapsody. Elevate your dining experience with the perfect soundtrack for every bite.
    Get ready to groove and grub – because the best meals always come with a side of great music!</p>

<h4>Please visit <a href="https://musicstoreweb20240902150809.azurewebsites.net/">Rhapsody</a> for more information</h4>

    <div class="container">
        <div class="row justify-content-center">

        </div>
    </div>

@foreach (var album in Model)
{
    <div class="col-md-3 mb-4 d-flex align-items-stretch">
        <div style="width: 100%; height:100%;">
            <img src="@album.CoverImageUrl" class="card-img-top" alt="Cover Image" />
            <div class="card-body">
                <h2 class="card-title">@album.Title</h2>
                <p class="card-text">
                    @if (album.Artists != null && album.Artists.Any())
                    {
                        @foreach (var artist in album.Artists)
                        {
                            <h6>@artist.Name</h6>
                        }

                    }
                    else
                    {
                    <p>No artists</p>
                    }
                </p>
                <p class="card-text">
                    @album.Type
                </p>
                <p class="card-text">@album.Description</p>
                <div class="mt-auto">
                    <a href="https://musicstoreweb20240902150809.azurewebsites.net/Albums/Details/{@album.Id}" class="btn">Jam On</a>
                </div>
            </div>
        </div>
    </div>
}
